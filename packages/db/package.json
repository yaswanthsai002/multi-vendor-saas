{
  "name": "@repo/db",
  "version": "0.1.0",
  "private": true,
  "files": [
    "dist",
    "drizzle"
  ],
  "engines": {
    "node": ">=22 <23"
  },
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "development": "./src/schema/index.ts",
      "types": "./dist/schema/index.d.ts",
      "default": "./dist/schema/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "generate": "drizzle-kit generate",
    "migrate": "drizzle-kit migrate",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "dotenv": "^17.3.1",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.9.3"
  }
}
